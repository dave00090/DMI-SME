DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_PASSKEY=""
DARAJA_SHORTCODE="174379"
DARAJA_ENVIRONMENT="sandbox"
DARAJA_CALLBACK_URL=""

